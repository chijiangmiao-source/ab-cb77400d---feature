# Copy to .env (already gitignored) or export directly:
#   AUDIT_HOST_PORT=9090 docker compose up --build
AUDIT_HOST_PORT=8080

# Test/demo hook used by scripts/acceptance_jobs.py: artificial delay (in
# seconds) while an async job is in `running`, so the crash-recovery
# acceptance has a reliable kill window. Keep 0 in normal operation.
AUDIT_JOB_DELAY_SECONDS=0
